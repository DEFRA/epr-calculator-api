{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "EPR.Calculator": "Verbose",
        "EPR.CommonDataService": "Verbose"
      }
    }
  },

  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ResultFileCsvContainer": "paycal",
    "BillingFileCsvContainer": "paycal-billingfilecsv",
    "BillingFileJsonContainer": "paycal-billingfilejson",
    "FssContainer": "paycal-billingfilejsonauthorisedforfss"
  },

  "CommonDataApi": {
    "DataLoader": {
      "Enabled": true
    }
  },

  "Database": {
    "ConnectionString": "",
    "CommandTimeout": "00:05:00"
  },

  "FeatureFlags": {
    "UploadFssBillingFileToBlobStorage": true
  },

  "Synapse": {
    "ConnectionString": ""
  }
}
